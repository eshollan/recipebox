<div id="<%= dom_id recipe %>">
  <p>
    <strong>Title:</strong>
    <%= recipe.title %>
  </p>

  <p>
    <strong>Desc:</strong>
    <%= recipe.desc %>
  </p>

  <p>
    <strong>Instructions:</strong>
    <%= recipe.instructions %>
